# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-required-for-docker
POSTGRES_DB=portfolio

# Security
# Required for docker-compose — must be at least 32 characters
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_EXPIRE_MINUTES=15
ADMIN_EMAILS=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=
SEED_ADMIN_PASSWORD=

# GitHub Integration
GITHUB_USERNAME=TurkishKEBAB
GITHUB_API_TOKEN=
# Optional: Increases rate limit from 60 to 5000 requests/hour
# Needs `read:user` scope for GraphQL stats/contributions (Command Center)

# WakaTime Integration (Command Center coding stats)
# Secret API Key from https://wakatime.com/settings/account
WAKATIME_API_KEY=

# Optional Email Configuration (Gmail)
# Contact messages are still saved in the admin panel when these are empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Hosts that block outbound SMTP hang until this fires (twice per submission).
SMTP_TIMEOUT_SECONDS=5
# Set false where SMTP is unreachable (e.g. Railway): delivery is skipped and
# the message is read from the admin inbox instead.
EMAIL_ENABLED=true
# Generate app password: https://myaccount.google.com/apppasswords

# Redis Configuration
# For docker-compose: REDIS_URL is auto-set from REDIS_PASSWORD
REDIS_URL=redis://localhost:6379/0
# Required for docker-compose (sets requirepass on Redis server)
REDIS_PASSWORD=change-me-required-for-docker

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET_NAME=portfolio-files

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# Production: https://yigitokur.vercel.app
CORS_EXTRA_ORIGINS=

# Environment
ENVIRONMENT=development
# Options: development, staging, production
# Production required: ENVIRONMENT=production

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=Yiğit Okur Portfolio API
VERSION=1.0.0
API_HOST=127.0.0.1
API_PORT=8000

# Rate Limiting
AUTH_LOGIN_RATE_LIMIT=5/minute
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CONTACT_RATE_LIMIT=5/minute

# CAPTCHA (Turnstile/hCaptcha/reCAPTCHA)
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=
CAPTCHA_REQUIRED_PATHS=/api/v1/contact/
# Accept contact submissions even when the CAPTCHA provider rejects them
# (revoked site key, Cloudflare outage). Keeps the contact form reachable; the
# rate limiter stays as the abuse control and every bypass is logged.
CAPTCHA_FAIL_OPEN=false
# Production required:
# CAPTCHA_ENABLED=true
# CAPTCHA_PROVIDER=turnstile
# CAPTCHA_SECRET_KEY=<set-secret>
# CAPTCHA_FAIL_OPEN=true

# GitHub Cache
GITHUB_CACHE_HOURS=24

# File Upload
MAX_UPLOAD_SIZE=10485760
# 10MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Observability (optional; required for production error reporting)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Prefer deploy-provided git SHA. Set explicitly when the platform does not expose one.
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Production required minimums:
# SECRET_KEY=<at-least-32-characters>
# FRONTEND_URL=https://<production-frontend-domain>
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<db>
