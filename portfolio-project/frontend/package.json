{
  "name": "portfolio-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "lint": "eslint . --ext ts,tsx,mts --report-unused-disable-directives --max-warnings 0",
    "check:server-boundaries": "node ./scripts/check-public-server-components.mjs",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/services/apiTypes.generated.ts",
    "check:api-types": "npm run gen:api && git diff --exit-code -- src/services/apiTypes.generated.ts",
    "type-check": "tsc --noEmit",
    "preview": "next start --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "overrides": {
    "postcss": "8.5.16",
    "js-yaml": "4.3.0",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.65.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "highlight.js": "^11.11.1",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.11",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.5.16",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^4.1.9"
  }
}
